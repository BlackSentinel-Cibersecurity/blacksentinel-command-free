# ============================================================================
# BlackSentinel Command - Development Environment Configuration
# ============================================================================

# Application
NODE_ENV=development
APP_NAME=BlackSentinel Command
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

# Security (Development only - do not use in production)
JWT_SECRET=dev-jwt-secret-for-development-only-change-in-production
JWT_EXPIRATION=86400
JWT_REFRESH_EXPIRATION=604800
ENCRYPTION_KEY=dev-encryption-key-for-development-only
API_KEY_SALT=dev-api-key-salt
SESSION_SECRET=dev-session-secret
CSRF_SECRET=dev-csrf-secret

# Authentication (OIDC/SAML) - Optional in development
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/callback
SAML_ENTRY_POINT=
SAML_ISSUER=blacksentinel-command
SAML_CERT=

# Database (Docker Compose)
DATABASE_URL=postgresql://blacksentinel:blacksentinel@localhost:5432/blacksentinel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Redis (Docker Compose)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# Neo4j (Docker Compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=blacksentinel

# Elasticsearch (Docker Compose)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Kafka (Docker Compose)
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# AI/ML (Optional in development)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
AI_ENGINE_ENABLED=false

# Object Storage (Optional in development)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Email (Optional in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BlackSentinel Command <noreply@localhost>

# Webhooks
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_TIMEOUT=5000

# Rate Limiting (Relaxed for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_BLOCK_DURATION_MS=300000

# CORS (Allow all origins in development)
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE=

# Monitoring (Disabled in development)
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags (Enable all in development)
FEATURE_AI_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_MULTI_TENANT=true
FEATURE_ADVANCED_REPORTS=true

# Multi-Tenant (Relaxed for development)
TENANT_ISOLATION=shared
MAX_TENANTS=10
TENANT_STORAGE_QUOTA=1073741824

# Compliance (Relaxed for development)
AUDIT_LOG_RETENTION_DAYS=30
SESSION_RECORDING_ENABLED=false
DATA_ENCRYPTION_AT_REST=false
DATA_ENCRYPTION_IN_TRANSIT=false

# Backup (Disabled in development)
BACKUP_ENABLED=false
BACKUP_SCHEDULE=
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=

# Tenant Configuration (Development tenant)
TIER=professional
LICENSE_KEY=

# Development Tools
HOT_RELOAD=true
DEBUG_MODE=true
VERBOSE_LOGGING=true
