# ============================================================================
# BlackSentinel Command - Environment Configuration
# ============================================================================

# Application
NODE_ENV=production
APP_NAME=BlackSentinel Command
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0

# Security
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800
ENCRYPTION_KEY=your-256-bit-encryption-key
API_KEY_SALT=your-api-key-salt
SESSION_SECRET=your-session-secret
CSRF_SECRET=your-csrf-secret

# Authentication (OIDC/SAML)
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=https://command.blacksentinel.io/callback
SAML_ENTRY_POINT=https://your-saml-provider.com/sso
SAML_ISSUER=blacksentinel-command
SAML_CERT=your-saml-certificate

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/blacksentinel
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_SSL=true

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=true

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Elasticsearch
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your-elasticsearch-password

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_SSL=true
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=your-kafka-username
KAFKA_SASL_PASSWORD=your-kafka-password

# AI/ML
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
AI_ENGINE_ENABLED=true

# Object Storage (S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=blacksentinel-command-assets

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@blacksentinel.io
SMTP_PASS=your-smtp-password
SMTP_FROM=BlackSentinel Command <notifications@blacksentinel.io>

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_BLOCK_DURATION_MS=3600000

# CORS
CORS_ORIGIN=https://command.blacksentinel.io
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/blacksentinel/command.log

# Monitoring
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=https://your-sentry-dsn
SENTRY_ENVIRONMENT=production

# Feature Flags
FEATURE_AI_ENABLED=true
FEATURE_MARKETPLACE_ENABLED=true
FEATURE_MULTI_TENANT=true
FEATURE_ADVANCED_REPORTS=true

# Multi-Tenant
TENANT_ISOLATION=strict
MAX_TENANTS=1000
TENANT_STORAGE_QUOTA=107374182400

# Compliance
AUDIT_LOG_RETENTION_DAYS=365
SESSION_RECORDING_ENABLED=true
DATA_ENCRYPTION_AT_REST=true
DATA_ENCRYPTION_IN_TRANSIT=true

# Backup
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=blacksentinel-backups
